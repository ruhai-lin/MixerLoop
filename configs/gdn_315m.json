{
  "architectures": [
    "GatedDeltaNetForCausalLM"
  ],
  "allow_neg_eigval": false,
  "attn_mode": "chunk",
  "attnres_block_size": null,
  "bos_token_id": 1,
  "conv_size": 4,
  "eos_token_id": 2,
  "expand_v": 1.0,
  "fuse_cross_entropy": true,
  "fuse_linear_cross_entropy": false,
  "fuse_norm": true,
  "fuse_swiglu": true,
  "head_dim": 64,
  "hidden_act": "swish",
  "hidden_ratio": 4,
  "hidden_size": 1024,
  "initializer_range": 0.02,
  "intermediate_size": 2880,
  "max_position_embeddings": 1024,
  "model_type": "gated_deltanet",
  "norm_eps": 1e-05,
  "num_heads": 16,
  "num_hidden_layers": 20,
  "num_v_heads": null,
  "tie_word_embeddings": true,
  "use_cache": false,
  "use_gate": true,
  "use_l2warp": false,
  "use_short_conv": true,
  "vocab_size": 32000
}
