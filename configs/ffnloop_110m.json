{
  "architectures": ["FFNLoopForCausalLM"],
  "attn_mode": "chunk",
  "bos_token_id": 1,
  "conv_size": 4,
  "eos_token_id": 2,
  "expand_v": 1.0,
  "fuse_cross_entropy": true,
  "fuse_linear_cross_entropy": false,
  "fuse_norm": true,
  "fuse_swiglu": true,
  "head_dim": 64,
  "hidden_act": "swish",
  "hidden_ratio": 4,
  "hidden_size": 768,
  "initializer_range": 0.02,
  "intermediate_size": 2048,
  "loop_count": 4,
  "max_position_embeddings": 1024,
  "model_type": "ffnloop",
  "norm_eps": 1e-5,
  "num_heads": 12,
  "num_hidden_layers": 12,
  "tie_word_embeddings": true,
  "use_cache": false,
  "use_residual": true,
  "vocab_size": 32000
}
